CREATE TABLE Orders (
    Id INT IDENTITY(1,1) PRIMARY KEY,
    CustomerName NVARCHAR(100),
    CustomerAddress NVARCHAR(200),
    Email NVARCHAR(100),
    MobileNo NVARCHAR(20),
    LaptopModel NVARCHAR(100),
    RAM NVARCHAR(50),
    CPU NVARCHAR(50),
    Quantity INT,
    CreatedDate DATETIME DEFAULT GETDATE()
);